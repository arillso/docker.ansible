{
    "$schema": "https://docs.renovatebot.com/renovate-schema.json",
    "extends": [
        "github>arillso/.github:renovate-base#2026-10-23",
        "github>arillso/.github:renovate-alpine#2026-10-23"
    ],
    "packageRules": [
        {
            "description": "Trivy is intentionally not digest-pinned; the action resolves its scanner version from the tag.",
            "matchManagers": ["github-actions"],
            "matchPackageNames": ["aquasecurity/trivy-action"],
            "pinDigests": false
        }
    ]
}
